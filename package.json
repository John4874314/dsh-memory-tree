{
  "name": "dsh-dual-memory-tree",
  "version": "0.1.2",
  "type": "module",
  "description": "Dual-tree long-term memory for DeepSeek Harness: a task tree per working directory and one global habit tree, with decay scheduling, three-hop retrieval, handoff briefs, and a dual-tree visualization panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "long-term-memory",
    "memory-tree",
    "forgetting-curve",
    "handoff"
  ],
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "author": "John4874314 <dmapa6168@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John4874314/dsh-memory-tree.git"
  },
  "homepage": "https://github.com/John4874314/dsh-memory-tree#readme",
  "bugs": {
    "url": "https://github.com/John4874314/dsh-memory-tree/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
